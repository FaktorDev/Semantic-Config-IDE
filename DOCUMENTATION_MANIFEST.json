  "canonicalMigrationRules": [
    "Use explicit //@config for every intended logical config.",
    "Use exactly one explicit //@template per logical config.",
    "Never turn the first real runtime entity into a template.",
    "Preserve runtime semantics unless an intentional change is documented.",
    "Do not infer PK, FK, enum, range, optionality, default, or public visibility without evidence.",
    "Use canonical directive spellings in migrated files.",
    "Public-only export is fail-closed and must include projected JSON, templates, schemas, and generated code.",
    "Produce a migration report and a ready archive when requested."
